        },
        "/conversations/group": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Create a new group conversation with multiple users",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "conversations"
                ],
                "summary": "Create a group conversation",
                "parameters": [
                    {
                        "description": "Group conversation data",
                        "name": "request",
                        "in": "body",
